# ==============================================================================
# SIH HOSPITAL AI — PRODUCTION DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env.production on your secure production host:
#   cp .env.production.example /etc/sih-hospital-ai/production.env
#
# CRITICAL SECURITY INVARIANTS ENFORCED AT STARTUP:
# 1. ENVIRONMENT must be set to 'production'
# 2. DATABASE_URL must point to PostgreSQL (SQLite/JSON forbidden)
# 3. JWT_SECRET_KEY must be a unique, cryptographically random key (>= 32 chars)
# 4. SIH_EMAIL_BACKEND must be set to 'smtp'
# 5. SIH_OTP_PROVIDER must be set to 'EMAIL'
# 6. SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD, and SMTP_FROM_EMAIL must be valid
# 7. Wildcard CORS origins ('*') are strictly rejected
# 8. Never store or commit real production secrets into Git
# ==============================================================================

# --- Application Runtime Environment ---
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# --- Allowed CORS Origins (Strict FQDNs without trailing slashes) ---
CORS_ORIGINS=https://hospital.sih.gov.in,https://admin.hospital.sih.gov.in

# --- Database Configuration (PostgreSQL 15+ Cluster) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://sih_app_user:REPLACE_WITH_SECURE_DB_PASSWORD@postgres.internal.net:5432/sih_hospital_prod?sslmode=prefer
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Distributed Cache & Rate Limiting (Redis Sentinel / Cluster) ---
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis.internal.net:6379/0
REDIS_REQUIRED=true

# --- Authentication & JWT Security ---
# Generate using: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_MINIMUM_32_CHARACTERS_CRYPTOGRAPHIC_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
APPLICANT_JWT_EXPIRE_MINUTES=720

# --- Brevo Production SMTP Configuration ---
SIH_EMAIL_BACKEND=smtp
SIH_OTP_PROVIDER=EMAIL

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Brevo SMTP login account (from Brevo -> SMTP & API -> SMTP):
SMTP_USERNAME=REPLACE_WITH_BREVO_SMTP_LOGIN_EMAIL
# Brevo SMTP Key (from Brevo -> SMTP & API -> Generate a new SMTP key):
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY_xsmtpsib-...
# Officially verified sender address on your Brevo domain:
SMTP_FROM_EMAIL=no-reply@hospital.sih.gov.in
SMTP_USE_TLS=true
SMTP_TIMEOUT=15

# --- Transactional Outbox Worker ---
OUTBOX_POLL_INTERVAL=5.0
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_TIMEOUT_SECONDS=300
OUTBOX_MAX_RETRIES=5

# --- Document Storage & Security ---
STORAGE_BASE_DIR=/var/lib/sih_hospital/documents
MAX_DOCUMENT_SIZE_MB=10
ENABLE_MALWARE_SCAN=true

# --- Frontend (Next.js) Public API Base URL ---
NEXT_PUBLIC_API_URL=https://hospital.sih.gov.in/api
