# ==============================================================================
# SIH HOSPITAL AI — DEVELOPMENT / LOCAL TESTING ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Never commit .env with actual credentials to version control.
# ==============================================================================

# --- Application Runtime Environment ---
# Values: development | testing | production
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# --- Allowed CORS Origins (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database Configuration (PostgreSQL or SQLite) ---
# For local dev with SQLite (default if empty):
DATABASE_URL=sqlite:///data/hospital_app.db
# For local PostgreSQL testing:
# DATABASE_URL=postgresql://localhost:5432/sih_hospital_phase1_run_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Distributed Cache & Rate Limiting (Redis) ---
# In development, Redis is optional (falls back to in-memory rate limiting):
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false

# --- Authentication & JWT Security ---
# In development, a fallback key is tolerated; in production, minimum 32 chars required:
JWT_SECRET_KEY=sih-hospital-ai-demo-secret-change-later
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
APPLICANT_JWT_EXPIRE_MINUTES=1440

# --- Email & Brevo SMTP Configuration ---
# Values: simulated | smtp
SIH_EMAIL_BACKEND=simulated
# Values: SIMULATED | CONSOLE | EMAIL
SIH_OTP_PROVIDER=SIMULATED

# For Brevo SMTP testing:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Brevo SMTP login email:
SMTP_USERNAME=your-brevo-login@domain.com
# Brevo SMTP key (from Brevo -> SMTP & API -> SMTP tab -> Generate a new SMTP key; NOT a generic API key):
SMTP_PASSWORD=your_brevo_smtp_key_here
SMTP_FROM_EMAIL=no-reply@hospital.sih.gov.in
SMTP_USE_TLS=true
SMTP_TIMEOUT=10

# --- Transactional Outbox Worker ---
OUTBOX_POLL_INTERVAL=5.0
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_TIMEOUT_SECONDS=300
OUTBOX_MAX_RETRIES=5

# --- Document Storage & Security ---
STORAGE_BASE_DIR=/tmp/sih_hospital_documents
MAX_DOCUMENT_SIZE_MB=10
ENABLE_MALWARE_SCAN=true

# --- Frontend (Next.js) Public API URL ---
NEXT_PUBLIC_API_URL=http://localhost:8000
